{
  "manifest_version": 3,
  "name": "GitHub Repo Intelligence",
  "version": "1.0.0",
  "description": "Ask questions about any GitHub repo, get grounded answers with file/line citations, and prep for interviews on real code.",
  "permissions": ["activeTab", "storage", "scripting", "sidePanel"],
  "host_permissions": ["https://github.com/*", "http://localhost:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "Repo Intelligence",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
